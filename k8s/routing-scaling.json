{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "Ingress",
      "metadata": {
        "name": "wanderlust",
        "namespace": "progree-task4"
      },
      "spec": {
        "ingressClassName": "traefik",
        "rules": [
          {
            "http": {
              "paths": [
                {
                  "path": "/api",
                  "pathType": "Prefix",
                  "backend": {
                    "service": {
                      "name": "backend",
                      "port": {
                        "number": 5000
                      }
                    }
                  }
                },
                {
                  "path": "/health",
                  "pathType": "Prefix",
                  "backend": {
                    "service": {
                      "name": "backend",
                      "port": {
                        "number": 5000
                      }
                    }
                  }
                },
                {
                  "path": "/",
                  "pathType": "Prefix",
                  "backend": {
                    "service": {
                      "name": "frontend",
                      "port": {
                        "number": 8080
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "apiVersion": "autoscaling/v2",
      "kind": "HorizontalPodAutoscaler",
      "metadata": {
        "name": "backend",
        "namespace": "progree-task4"
      },
      "spec": {
        "scaleTargetRef": {
          "apiVersion": "apps/v1",
          "kind": "Deployment",
          "name": "backend"
        },
        "minReplicas": 2,
        "maxReplicas": 4,
        "metrics": [
          {
            "type": "Resource",
            "resource": {
              "name": "cpu",
              "target": {
                "type": "Utilization",
                "averageUtilization": 60
              }
            }
          }
        ],
        "behavior": {
          "scaleDown": {
            "stabilizationWindowSeconds": 60,
            "policies": [
              {
                "type": "Pods",
                "value": 1,
                "periodSeconds": 30
              }
            ]
          },
          "scaleUp": {
            "stabilizationWindowSeconds": 0,
            "policies": [
              {
                "type": "Pods",
                "value": 2,
                "periodSeconds": 30
              }
            ]
          }
        }
      }
    }
  ]
}
